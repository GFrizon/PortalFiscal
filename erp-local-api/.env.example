APP_ENV=production
APP_DEBUG=false
APP_PORT=8088

API_TOKEN=troque_por_um_token_longo_com_64_ou_mais_caracteres
API_ALLOWED_IPS=127.0.0.1,::1
API_REQUIRE_HTTPS=false

# Drivers: simulated, csv, odbc, oracle
ERP_DRIVER=simulated

# CSV driver
CSV_PATH=storage/purchase-orders.csv

# ODBC driver for Windows DSN
ODBC_DSN=CIGAM
ODBC_USER=
ODBC_PASSWORD=
ODBC_QUERY="SELECT TOP 1 numero AS purchase_order_number, status AS status, fornecedor_codigo AS supplier_code, fornecedor_cnpj AS supplier_cnpj, fornecedor_nome AS supplier_name, total AS amount FROM ordens_compra WHERE numero = ?"

# Oracle driver, if PHP has oci8 installed
ORACLE_UID=
ORACLE_PWD=
ORACLE_DBQ=192.168.0.6:1521/orcl
ORACLE_CHARSET=AL32UTF8
ORACLE_QUERY="SELECT * FROM (SELECT CD_ORDEM_COMPRA AS PURCHASE_ORDER_NUMBER, SITUACAO AS STATUS, CNPJ_CPF AS SUPPLIER_CNPJ, NOME_COMPLETO AS SUPPLIER_NAME, TOTAL_ORDEM AS AMOUNT FROM COORDEM WHERE TRIM(UPPER(TO_CHAR(CD_ORDEM_COMPRA))) = :number) WHERE ROWNUM = 1"

APP_NAME="Portal de Notas Fiscais"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://portal-notas.seudominio.com.br
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpanel_usuario_portal
DB_USERNAME=cpanel_usuario_portal
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SERVER=mail.bakof.com.br
MAIL_HOST=mail.bakof.com.br
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=fiscal@bakof.com.br
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=fiscal@bakof.com.br
MAIL_FROM_NAME="${APP_NAME}"

INVOICE_PDF_MAX_UPLOAD_KB=10240
INVOICE_PDF_OPTIMIZATION_ENABLED=false
INVOICE_PDF_OPTIMIZATION_BINARY=/usr/bin/gs
INVOICE_PDF_OPTIMIZATION_QUALITY=/ebook
INVOICE_PDF_OPTIMIZATION_TIMEOUT=60
INVOICE_PDF_OPTIMIZATION_MIN_SAVINGS_PERCENT=8

PDF_OCR_ENABLED=false
PDF_OCR_PDFTOPPM_BINARY=/usr/bin/pdftoppm
PDF_OCR_TESSERACT_BINARY=/usr/bin/tesseract
PDF_OCR_LANGUAGE=por
PDF_OCR_TIMEOUT=60
PDF_OCR_MAX_PAGES=2

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=45
OPENAI_PDF_DETAIL=high

ERP_PURCHASE_ORDER_DRIVER=http
ERP_API_BASE_URL=https://api-local-da-bakof.exemplo.com
ERP_API_TOKEN=
ERP_API_TIMEOUT=8
ERP_API_VERIFY_TLS=true

ERP_LOCAL_API_TOKEN=
ERP_LOCAL_API_ALLOWED_IPS=127.0.0.1
ERP_LOCAL_API_REQUIRE_HTTPS=true
